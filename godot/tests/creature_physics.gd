extends SceneTree
const B=preload("res://addons/creature/physical_body.gd")
const C=preload("res://addons/creature/physical_creature.gd")
var failures: int=0
func _initialize() -> void:
    create_timer(20.0).timeout.connect(func(): quit(1))
    call_deferred("_run")
func check(ok: bool,msg: String) -> void:
    if not ok:failures+=1;push_error(msg)
func _run() -> void:
    var floor_box:=Rect2(-1000,200,2000,80)
    var boxes: Array[Rect2]=[floor_box,Rect2(160,174,35,26)]
    var body=B.new()
    body.obstacles.append(floor_box)
    body.add_point("a",Vector2(0,50),7,1)
    body.add_point("b",Vector2(16,50),7,2)
    body.connect_points(0,1,16)
    for i in range(480):body.step()
    check(body.finite(),"finite after fall")
    check(body.penetration()<.01,"floor no penetration")
    check(body.max_error<.05,"rigid distance")
    check(absf(float(body.nodes[0].p.y)-193)<.1,"settled on floor")
    var a=C.new(Vector2(40,170),boxes,5,1,false)
    for i in range(180):a.advance(1.0/60,0,false,false)
    check(a.grounded,"grounded creature")
    var before: float=a.body.point("front").x
    for i in range(30):a.advance(1.0/60,1,false,false)
    print("Ground movement in 0.5 s: ",a.body.point("front").x-before," px")
    check(a.body.point("front").x>before+8,"movement")
    var y: float=a.body.point("front").y
    a.advance(1.0/60,1,true,false)
    for i in range(15):a.advance(1.0/60,1,false,false)
    check(a.jump_count==1 and a.body.point("front").y<y-5,"jump impulse")
    a.advance(1.0/60,0,true,false)
    check(a.jump_count==1,"no air jump")
    for i in range(600):a.advance(1.0/60,-1 if i%120>60 else 1,false,false)
    check(a.body.finite(),"stress finite")
    check(a.body.penetration()<.05,"stress collision")
    check(a.body.max_error<4,"stress distance")
    var b=C.new(Vector2(40,170),boxes,12,2,false)
    check(b.body.nodes.size()==14,"arbitrary tail")
    for i in range(120):b.advance(1.0/60,1,false,false)
    check(b.body.finite() and b.body.penetration()<.05,"long body")
    var c=C.new(Vector2(40,170),boxes,0,1,false)
    var d=C.new(Vector2(40,170),boxes,0,1,false)
    for i in range(120):c.advance(1.0/60,1,false,false)
    for i in range(60):d.advance(1.0/30,1,false,false)
    check(c.body.steps==d.body.steps,"fixed tick count")
    check(c.body.point("front").distance_to(d.body.point("front"))<.001,"fixed timestep determinism")
    var e=C.new(Vector2(150,166),boxes,0,1,false)
    e.advance(1.0/60,1,false,false)
    check(e.grip_count>0,"near ledge grip")
    e.advance(1.0/60,-1,false,false)
    check(e.grip_index==-1,"cancel grip by reversing")
    var wall: Array[Rect2]=[floor_box,Rect2(160,70,40,130)]
    var f=C.new(Vector2(148,193),wall,0,1,false)
    for i in range(60):f.advance(1.0/60,1,false,false)
    check(f.grip_count==0,"No auto-grip from base of high wall")
    var g=C.new(Vector2(150,166),boxes,0,1,false)
    for i in range(120):g.advance(1.0/60,1,false,false)
    print("Automatic ledge climb: grips ",g.grip_count," front ",g.body.point("front"))
    check(g.grip_count>0 and g.body.point("front").x>175,"Auto ledge crosses edge")
    var flat: Array[Rect2]=[floor_box]
    var h=C.new(Vector2(40,170),flat,5,1,true)
    for i in range(240):h.advance(1.0/60,0,false)
    print("Leg support idle: ",h.limbs.support_count," height ",200-h.body.point("front").y)
    check(h.limbs.support_count>=2 and h.body.point("front").y<188,"Legs support body above floor")
    var hx: float=h.body.point("front").x
    for i in range(120):h.advance(1.0/60,1,false)
    print("Procedural gait: ",h.limbs.steps_taken," steps; moved ",h.body.point("front").x-hx," px")
    check(h.limbs.steps_taken>2 and h.body.point("front").x>hx+40,"Gait moves with footsteps")
    check(h.body.finite() and h.body.penetration()<.05,"Legged body stable")
    for l in h.limbs.legs:
        var hip: Vector2=h.body.nodes[l.parent].p
        check(absf(hip.distance_to(l.knee)-h.limbs.upper)<.02,"Upper IK length")
        check(absf(Vector2(l.knee).distance_to(l.tip)-h.limbs.lower)<.02,"Lower IK length")
    h.advance(1.0/60,1,true)
    check(h.jump_count==1 and h.limbs.support_count==0,"Legs release on jump")
    print("Physical body tests: failures ",failures,"; stress constraint ",a.body.max_error," px; penetration ",a.body.penetration())
    quit(0 if failures==0 else 1)
