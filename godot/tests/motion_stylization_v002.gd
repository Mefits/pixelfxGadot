extends SceneTree
const Stylizer=preload("res://lab/motion_stylization/stylizer.gd")
const Training=preload("res://lab/training_control.gd")
const Body=preload("res://lab/body_ankle_069.gd")
var failures:Array[String]=[]
func check(ok:bool,reason:String)->void:
    if not ok and not failures.has(reason):failures.append(reason)
func _initialize()->void:
    call_deferred("run")
func run()->void:
    var fx=Stylizer.new()
    fx.sample(0,"K",8,"foot_near",Vector2.ZERO,Vector2.ZERO,true)
    fx.sample(1,"K",9,"foot_near",Vector2(6,0),Vector2(6,0),true)
    check(fx.weight>0.,"velocity activates")
    check(fx.trail().size()>=2,"trajectory sampled")
    var previous_trail:Array=fx.trail().duplicate(true)
    fx.sample(1,"K",9,"foot_near",Vector2(60,0),Vector2(60,0),true)
    check(fx.trail()==previous_trail and fx.delta==Vector2(6,0),"same tick idempotent")
    var f=Training.new()
    var body=Body.new(2)
    var parts:Array=body.make(f.walker.rig.points,f.walker.pose.angles,f.walker.rig.rotations.head)
    var before:Array=parts.duplicate(true)
    var output:Array=fx.deform(parts)
    check(parts==before,"source geometry unchanged")
    check(output!=before,"active smear changes geometry")
    check(output[17]==before[17],"terminal foot unchanged")
    check(output[12].a==before[12].a and output[13].b==before[13].b,"root and distal endpoint unchanged")
    fx.sample(2,"K",10,"foot_near",Vector2(7,0),Vector2(7,0),false)
    check(fx.deform(parts)==parts,"accent uses original pose")
    fx.sample(3,"K",11,"foot_near",Vector2(8,0),Vector2(8,0),true,false,true)
    check(fx.deform(parts)==parts and fx.accent_lines().size()==5,"accent independent of deformation")
    fx.sample(4,"K",12,"foot_near",Vector2(8,0),Vector2(8,0),false,false)
    check(fx.accent_lines().size()==5,"accent second tick")
    fx.sample(5,"K",13,"foot_near",Vector2(8,0),Vector2(8,0),false,false)
    check(fx.accent_lines().is_empty(),"accent expires after two ticks")
    fx.reset()
    check(fx.trail().is_empty() and fx.deform(parts)==parts,"reset identity")
    print("MOTION_STYLIZATION_V002 ",JSON.stringify({"failures":failures}))
    quit(0 if failures.is_empty() else 1)
