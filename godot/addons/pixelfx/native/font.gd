static func height(font: String) -> int:
    return 7 if font=="big" else 5

static func _glyph(ch: String,font: String) -> PackedStringArray:
    var table: Dictionary=GLYPHS.get(font,GLYPHS["mini"])
    var src: String=table.get(ch,table.get(ch.to_upper(),""))
    return src.split("|") if src!="" else PackedStringArray()

static func text_width(value: String,font: String="mini") -> int:
    var w: int=0
    for ch in value:
        var rows: PackedStringArray=_glyph(ch,font)
        w+=(rows[0].length() if not rows.is_empty() else (3 if font=="big" else 2))+1
    return maxi(0,w-1)

static func pixels(value: String,font: String="mini") -> Array:
    var x: int=0
    var out: Array=[]
    for ch in value:
        var rows: PackedStringArray=_glyph(ch,font)
        if rows.is_empty():
            x+=(3 if font=="big" else 2)+1
            continue
        for r in range(rows.size()):
            for c in range(rows[r].length()):
                if rows[r][c]=="#":
                    out.append([x+c,r])
        x+=rows[0].length()+1
    return out
