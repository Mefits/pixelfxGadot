import os
env = SConscript("godot-cpp/SConstruct")
if env["platform"] == "windows" and not env.get("use_mingw", False):
    env.Append(CXXFLAGS=["/fp:strict"])
else:
    env.Append(CXXFLAGS=["-ffp-contract=off", "-fno-fast-math"])
env.Append(CPPPATH=["."])
qjs_lib = os.environ.get("PIXELFX_QJS_LIB")
if qjs_lib:
    env.Append(CPPDEFINES=["PFX_ORIGINAL"], CPPPATH=["quickjs-ng"], LIBS=[File(qjs_lib)])
    if env["platform"] == "linux":
        env.Append(LIBS=["dl","pthread","m"])
suffix = env["SHLIBSUFFIX"]
platform = env["platform"]
target = "../godot/addons/pixelfx/bin/" + ("pixelfx.windows.x86_64" if platform == "windows" else "libpixelfx.linux.x86_64")
lib = env.SharedLibrary(target=target + suffix, source=["extension.cpp"], SHLIBPREFIX="")
Default(lib)
